{
  "version": "1",
  "algo": "stack_cooccurrence_prior_v1",
  "date": "2026-08-02",
  "source": "population sketch (global browser share ~2025–2026) + engine/OS legitimacy matrix; NOT live CDN stats; lab-seeded, replaceable by ops aggregate later",
  "policy": {
    "never_force_merge_device": true,
    "never_target_peer_dh": true,
    "use_for": [
      "stack_anomaly_score",
      "channel_unconventional",
      "residual_b10x_prior",
      "preferred_domains",
      "ops_gap_tags"
    ],
    "not_use_for": [
      "commercial_digest",
      "mint_body",
      "peer_same_machine"
    ]
  },
  "notes": [
    "Rates are relative priors for co-occurrence, not traffic percentages to sum to 1.",
    "WebKit on Linux with Epiphany/GNOME Web = rare_native (legitimate WebKitGTK), residual measurement channel differs from Blink/ANGLE → B10x channel prior.",
    "Safari brand on Linux desktop = migration_suspect (real Safari does not ship on Linux).",
    "Chrome/Edge/Firefox on iOS = engine is WebKit by platform policy — common_native, NOT claim≠obs anomaly.",
    "Android major browsers = Blink (Chrome/Samsung/Edge/Opera) or rare Gecko; WebKit shell on Android is migration_suspect.",
    "Mobile vs desktop form mismatch is stronger than engine rarity alone."
  ],
  "thresholds": {
    "common_min_rate": 0.02,
    "uncommon_min_rate": 0.002,
    "rare_min_rate": 0.0001,
    "migration_suspect_max_rate": 0.00005,
    "anomaly_score_cap": 0.85,
    "channel_prior_if_status": [
      "rare_native",
      "uncommon_native",
      "channel_only"
    ],
    "anomaly_if_status": [
      "migration_suspect",
      "impossible",
      "conflict"
    ]
  },
