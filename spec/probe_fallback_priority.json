{
  "algo": "gv5_probe_fallback_priority_v1",
  "notes": [
    "Each B-batch field family lists ordered methods. First success wins for that family.",
    "Engine profiles override order: webkit / gecko / blink / mobile.",
    "Success means non-null usable value, not merely no-throw.",
    "Failed paths recorded in probe_paths for diagnostics — never invent values.",
    "engine_profiles[family].capabilities = per-family API availability table (SSOT). pack_engine_gate = engine allowlist for engine-gated B packs; component_catalog engines must match."
  ],
  "engine_profiles": {
    "blink": {
      "webrtc_budget_ms": 2500,
      "prefer": [
        "webgl2",
        "offline_audio",
        "ua_ch"
      ],
      "capabilities": {
        "wasm": true,
        "wasm_simd": true,
        "webgpu": true,
        "sab_coi": true,
        "ua_ch": true,
        "offscreen_webgl2": true,
        "offline_audio": true
      }
    },
    "gecko": {
      "webrtc_budget_ms": 3000,
      "prefer": [
        "webgl",
        "offline_audio",
        "no_ua_ch"
      ],
      "capabilities": {
        "wasm": true,
        "wasm_simd": true,
        "webgpu": true,
        "sab_coi": true,
        "ua_ch": false,
        "offscreen_webgl2": true,
        "offline_audio": true
      }
    },
    "webkit": {
      "webrtc_budget_ms": 4500,
      "prefer": [
        "webgl",
        "live_audio_sr",
        "empty_ice",
        "no_ua_ch"
      ],
      "capabilities": {
        "wasm": true,
        "wasm_simd": true,
        "webgpu": true,
        "sab_coi": true,
        "ua_ch": false,
        "offscreen_webgl2": false,
        "offline_audio": true
      }
    },
    "mobile_blink": {
      "webrtc_budget_ms": 3500,
      "prefer": [
        "webgl",
        "offline_audio",
        "ua_ch",
        "touch"
      ],
      "capabilities": {
        "wasm": true,
        "wasm_simd": true,
        "webgpu": true,
        "sab_coi": true,
        "ua_ch": true,
        "offscreen_webgl2": true,
        "offline_audio": true,
        "touch": true
      }
    },
    "mobile_webkit": {
      "webrtc_budget_ms": 5000,
      "prefer": [
        "webgl",
        "live_audio_sr",
        "touch"
      ],
      "capabilities": {
        "wasm": true,
        "wasm_simd": true,
        "webgpu": true,
        "sab_coi": true,
        "ua_ch": false,
        "offscreen_webgl2": false,
        "offline_audio": true,
        "touch": true
      }
    }
  },
