  "mint_dual_source_rule": {
    "summary": "A field enters commercial device_id only if ≥2 sources agree OR dual-channel pair present",
    "sources": [
      "main",
      "iframe",
      "worker",
      "shared_worker"
    ],
    "dual_channels": [
      [
        "hw_curve_webgl",
        "hw_curve_audio"
      ],
      [
        "residual_std",
        "hw_curve_webgl"
      ],
      [
        "webrtc_host_ip_hash",
        "os_instance_hash"
      ],
      [
        "media_device_count",
        "display_count"
      ]
    ]
