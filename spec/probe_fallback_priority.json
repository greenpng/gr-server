  "pack_engine_gate": {
    "B92_webgpu_atomic_contention": {
      "engines": [
        "blink",
        "gecko",
        "webkit"
      ],
      "capability": "webgpu",
      "note": "WebGPU shipped in all three; FE still honest-skips when adapter absent."
    },
    "B93_blink_fork_matrix": {
      "engines": [
        "blink"
      ],
      "capability": "ua_ch",
      "note": "UA-CH brand surface is blink-only (gecko/webkit do not ship sec-ch-ua)."
    },
    "B94_sab_dual_clock_differential": {
      "engines": [
        "blink",
        "gecko",
        "webkit"
      ],
      "capability": "sab_coi",
      "note": "SAB+COOP/COEP available in all three; FE skips without isolation."
    },
    "B95_gpu_eu_timing": {
      "engines": [
        "blink"
      ],
      "capability": "offscreen_webgl2",
      "note": "DrawnApart EU timing via OffscreenCanvas webgl2; Chromium-only (engine gate)."
