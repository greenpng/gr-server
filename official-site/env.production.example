# Official site — production env template
#
# Lab: unified marketing + account (official-web :3000)
# GR_OFFICIAL_WEB_ORIGIN=http://127.0.0.1:3000
# GV6_OFFICIAL_WEB_ORIGIN=http://127.0.0.1:3000  (legacy alias)
# GR_REQUIRE_DOMAIN_VERIFY=1   # optional on main API — no separate :4102 test port
# GV6_REQUIRE_DOMAIN_VERIFY=1   (legacy alias)
#
# Production:
# 8.0+: prefer GR_* names; legacy GV6_* aliases are still accepted by the server.
#   set -a; source env.production.example; set +a; npm start
#   (copy to a real secrets file; do not commit secrets)

GR_DEPLOY_ENV=production
GR_OFFICIAL_PORT=4101
GR_OFFICIAL_PUBLIC_URL=https://official.example.com
GR_OFFICIAL_WEB_ORIGIN=https://official.example.com
GR_OFFICIAL_DATA=/var/lib/gr-official

# Required signing/encryption secrets. Inject from KMS/HSM/secret manager at
# process start; never store these values in PostgreSQL or this file.
# GR_LICENSE_SIGNING_KEY_PEM=<Ed25519 PKCS8 PEM>
# GR_BUNDLE_SIGNING_KEY_PEM=<different Ed25519 PKCS8 PEM>
# GR_BUNDLE_WRAP_KEY_B64=<base64 of 32 random bytes>
# Alternatively, a mounted 0600 secret containing bundle key JSON:
# GR_BUNDLE_KEY_FILE=/run/secrets/gr_bundle_keys.json

# PostgreSQL (required — local and production)
GR_DATABASE_URL=postgresql://gv6:gv6@127.0.0.1:5432/gr_official

# ECDH algo-bundle only — never expose shared wrap key in prod
# (omit or set 0; IS_PROD also forces wrap-key 404)
GR_OFFICIAL_EXPOSE_WRAP_KEY=0

# Paid domains must pass DNS TXT / well-known verify before paid bundles
GR_REQUIRE_DOMAIN_VERIFY=1

# Do not echo email verify tokens in API responses
GR_OFFICIAL_LAB_EMAIL=0

GR_ADMIN_OAUTH_REDIRECTS=https://panel.example.com/oauth/callback
GR_OAUTH_CLIENT_ID=gr-admin-panel

# CMS admin UI — required in production (≥12 chars, unguessable). Lab default: cms-lab-dev
# Example: openssl rand -hex 16
GR_ADMIN_CMS_PATH=CHANGE_ME_random_32chars

# Comma-separated staff emails for CMS (required in production; empty = nobody)
GR_CMS_ADMIN_EMAILS=ops@example.com

# Trust X-Forwarded-For only after the edge strips client-supplied values
GR_TRUST_PROXY=0

# ── Stripe billing (production) ───────────────────────────────────
# Required for production checkout + webhooks. Omit in lab → MockBillingAdapter.
# Secret key from Stripe Dashboard (never commit; use a secrets manager).
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
# Signing secret from Stripe Dashboard → Webhooks endpoint.
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
# Price ID for the $99/site/year subscription product.
STRIPE_PRICE_ID=price_CHANGE_ME
# Redirect URLs after Stripe Checkout (must be on your domain).
STRIPE_SUCCESS_URL=https://official.example.com/account?billing=success
STRIPE_CANCEL_URL=https://official.example.com/account?billing=cancelled
# Override defaults (optional): STRIPE_ANNUAL_USD=99, STRIPE_PERIOD_MS, STRIPE_GRACE_MS

# ── Gmail SMTP (email verification) ────────────────────────────────
# Required for production email verification. Omit in lab → no-op fallback.
# Use a Gmail app password (not your account password); never commit.
GMAIL_USER=ops@example.com
GMAIL_APP_PASSWORD=CHANGE_ME_app_password
# Optional overrides:
# GMAIL_FROM=noreply@example.com
# GMAIL_SMTP_HOST=smtp.gmail.com
# GMAIL_SMTP_PORT=465

# Unified marketing + account site (Next SSR)
GR_OFFICIAL_WEB_ORIGIN=https://www.example.com
