{
  "name": "gv6-official-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev": "node --watch server/src/index.js",
    "start": "node server/src/index.js",
    "web:dev": "npm run dev --prefix web",
    "web:build": "npm run build --prefix web",
    "seed": "node server/src/seed.js",
    "test:smoke": "node server/scripts/smoke.js",
    "test:content": "node server/scripts/content_smoke.js",
    "test:functional": "node server/scripts/functional_e2e.js",
    "test:security": "node server/scripts/security_adversarial.js",
    "test:billing": "node server/scripts/billing_unit.js",
    "test:stripe": "node server/scripts/stripe_unit.js",
    "test:integrations": "node server/scripts/integration_settings_unit.js",
    "test:bundle-key": "node server/scripts/bundle_key_unit.js",
    "test:all": "npm run test:billing && npm run test:stripe && npm run test:integrations && npm run test:bundle-key && npm run test:smoke && npm run test:content && npm run test:functional && npm run test:security",
    "test:ui": "bash scripts/run_ui_tests.sh"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1",
    "nodemailer": "^6.10.1",
    "pg": "^8.13.1",
    "stripe": "^17.7.0"
  }
}
